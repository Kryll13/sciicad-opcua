# ============================================================================
# Fichiers à NE JAMAIS committer — secrets et certificats
# ----------------------------------------------------------------------------
# tools/crypto_opcua.py écrit une clé privée NON chiffrée (NoEncryption) dans
# le dossier cible. Les serveurs la chargent au démarrage pour activer
# Basic256Sha256_SignAndEncrypt : ces fichiers sont donc régénérables et
# locaux par construction.
# ============================================================================
*.pem
*.key
*.der
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.trustlist
*.crl
*.p7b
*.p7c

# Store de certificats OPC UA (CertificateManager : trusted/issuer/rejected/private)
.opc-foundation/
certificates/
certificate-stores/

# ============================================================================
# Bases de données
# ----------------------------------------------------------------------------
# La base du GDS contient : hashes de mots de passe, journaux d'audit, et
# clés privées en base64 (CertificateRequest.private_key_data).
# ============================================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
gds.db
gds.db-*

# ============================================================================
# Configuration locale / secrets
# ----------------------------------------------------------------------------
# gds_config.yaml est versionné (c'est la référence), mais sa section
# database contient des identifiants en clair. Toute surcharge locale doit
# être dans un fichier *local* ignoré ici.
gds_config.local.yaml
gds_config.local.yml
*.local.yaml
*.local.yml
.env
.env.*
!.env.example

# ============================================================================
# Python
# ============================================================================
# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
.eggs/

# Extensions C
*.so

# PyInstaller
*.manifest

# ============================================================================
# Environnements virtuels
# ----------------------------------------------------------------------------
# .python-version et uv.lock sont volontairement SUIVIS (reproductibilité).
# ============================================================================
.venv
venv/
env/
ENV/
.python-version.local

# ============================================================================
# Tests, couverture, caches
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
cover/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ============================================================================
# Journaux
# ----------------------------------------------------------------------------
# gds_config.yaml.logging.file peut écrire un fichier de log.
# ============================================================================
*.log

# ============================================================================
# Éditeurs / OS
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
